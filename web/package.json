{
  "name": "manhole-card-map",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "bun check -b",
    "build": "bun run typecheck && vite build && node scripts/build/prepare.mjs",
    "preview": "node scripts/deploy/serve.mjs",
    "sizes": "node scripts/perf/sizes.mjs",
    "build:fixture": "bun run typecheck && vite build --mode fixture && node scripts/build/prepare.mjs --fixture",
    "build:fixture:ci": "vite build --mode fixture && node scripts/build/prepare.mjs --fixture",
    "test": "vitest run",
    "test:ci": "node scripts/ci/test-ci.mjs",
    "test:watch": "vitest",
    "lint": "oxlint --max-warnings=0 src scripts worker *.ts",
    "format": "oxfmt src scripts worker *.ts *.json *.jsonc .ox*.json .stylelintrc.json *.html",
    "format:check": "oxfmt --check src scripts worker *.ts *.json *.jsonc .ox*.json .stylelintrc.json *.html",
    "hooks:install": "python3 -B ../tools/dev/install_hooks.py",
    "test:browser": "node scripts/browser/browser-check.mjs && node scripts/browser/account.browser-check.mjs",
    "lint:css": "stylelint \"src/**/*.css\" \"*.html\"",
    "knip": "knip",
    "mutate": "mutator"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "5.3.1",
    "@simplewebauthn/server": "14.1.0",
    "clsx": "2.1.1",
    "lucide-react": "1.73.0",
    "maplibre-gl": "6.18.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.1"
  },
  "devDependencies": {
    "@mizchi/mutator": "0.4.5",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "knip": "6.45.1",
    "lefthook": "2.2.2",
    "oxc-parser": "0.158.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "playwright": "1.65.1",
    "postcss-html": "2.0.1",
    "sharp": "0.35.5",
    "stylelint": "18.0.0",
    "tailwindcss": "4.3.5",
    "tsrs": "7.1.0-beta.tsrs2",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.162.0"
  },
  "engines": {
    "bun": "1.4.4",
    "node": "24.22.1"
  },
  "packageManager": "bun@1.4.4"
}
