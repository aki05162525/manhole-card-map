{
  "name": "manhole-map-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "bun run typecheck && vite build && node scripts/prepare.mjs",
    "preview": "node scripts/serve.mjs",
    "measure": "node scripts/measure.mjs",
    "sizes": "node scripts/sizes.mjs",
    "build:fixture": "bun run typecheck && vite build --mode fixture && node scripts/prepare.mjs --fixture",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --max-warnings=0 src scripts *.ts",
    "format": "oxfmt src scripts *.ts *.json .ox*.json index.html",
    "format:check": "oxfmt --check src scripts *.ts *.json .ox*.json index.html",
    "hooks:install": "lefthook install",
    "build:comparison": "bun run typecheck && vite build && node scripts/prepare.mjs --comparison",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "@protomaps/basemaps": "5.7.2",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "maplibre-gl": "6.15.0",
    "pmtiles": "4.5.0"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "@types/leaflet.markercluster": "1.5.6",
    "@types/node": "26.6.5",
    "lefthook": "2.2.2",
    "lighthouse": "13.5.0",
    "mapshaper": "0.7.101",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "playwright": "1.64.1",
    "puppeteer-core": "25.15.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "engines": {
    "bun": "1.4.4",
    "node": "24.22.1"
  },
  "packageManager": "bun@1.4.4"
}
