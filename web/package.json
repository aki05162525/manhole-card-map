{
  "name": "manhole-map-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "bun run typecheck && vite build && node scripts/prepare.mjs",
    "preview": "node scripts/serve.mjs",
    "measure": "node scripts/measure.mjs",
    "sizes": "node scripts/sizes.mjs",
    "build:fixture": "bun run typecheck && vite build --mode fixture && node scripts/prepare.mjs --fixture",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --max-warnings=0 src scripts worker *.ts",
    "format": "oxfmt src scripts worker *.ts *.json *.jsonc .ox*.json .stylelintrc.json *.html",
    "format:check": "oxfmt --check src scripts worker *.ts *.json *.jsonc .ox*.json .stylelintrc.json *.html",
    "hooks:install": "python3 -B ../tools/dev/install_hooks.py",
    "test:browser": "node scripts/browser-check.mjs",
    "lint:css": "stylelint \"src/**/*.css\" \"*.html\"",
    "knip": "knip"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "5.3.1",
    "clsx": "2.1.1",
    "lucide-react": "1.68.0",
    "maplibre-gl": "6.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "31.0.0",
    "knip": "6.44.2",
    "lefthook": "2.2.2",
    "lighthouse": "13.5.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "playwright": "1.64.1",
    "postcss-html": "2.0.0",
    "puppeteer-core": "25.15.0",
    "stylelint": "18.0.0",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  },
  "engines": {
    "bun": "1.4.4",
    "node": "24.22.1"
  },
  "packageManager": "bun@1.4.4"
}
