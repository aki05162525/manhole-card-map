{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "manhole-card-map",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-06",
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    // Pages pass through the script so LINE can be sent to the default
    // browser; scripts, styles, data and images still skip it.
    "run_worker_first": [
      "/api/*",
      "/",
      "/cards",
      "/about",
      "/terms",
      "/account",
      "/friends",
      "/friends/invite",
      "/card/*",
    ],
  },
  // Invocation logs record full URLs (PR-2); the Worker logs one line itself.
  // The platform still attaches the request URL to that line, so drop queries.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "invocation_logs": false },
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://manhole-techo.com",
    "RP_ID": "manhole-techo.com",
  },
  // Previews use a generated copy without any D1 binding (TE-1).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "manhole-card-map",
      "database_id": "6577eead-a8d1-4828-aca5-af8a55585f58",
      "migrations_dir": "migrations",
    },
    {
      "binding": "TOMBSTONES",
      "database_name": "manhole-card-map-tombstones",
      "database_id": "13234e5c-adbf-4bed-a785-e848c5714828",
      "migrations_dir": "migrations-tombstones",
    },
  ],
  "env": {
    // Local only: `wrangler dev --env dev`. Never deploy this environment.
    "dev": {
      "vars": {
        "ALLOWED_ORIGIN": "http://localhost:8787",
        "RP_ID": "localhost",
        // Local only and public. Production uses `wrangler secret put`.
        "CHALLENGE_SECRET": "local-only-challenge-secret-not-for-production",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "manhole-card-map",
          "database_id": "local-manhole-card-map",
          "migrations_dir": "migrations",
        },
        {
          "binding": "TOMBSTONES",
          "database_name": "manhole-card-map-tombstones",
          "database_id": "local-manhole-card-map-tombstones",
          "migrations_dir": "migrations-tombstones",
        },
      ],
    },
  },
}
