{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.{ts,tsx}"],
      "excludeFiles": ["**/*.dom.test.*"],
      "rules": { "vitest/prefer-import-in-mock": "error" }
    },
    {
      "files": ["scripts/**/*.mjs"],
      "env": { "node": true },
      "rules": { "no-undef": "error" }
    },
    {
      "files": [
        "scripts/browser/**/*.mjs",
        "scripts/build/generate-seo-images.mjs",
        "scripts/perf/{map,sheet}-performance.mjs"
      ],
      "env": { "node": true, "browser": true }
    },
    {
      "files": ["{src,worker}/**/*.{ts,tsx}"],
      "excludeFiles": ["**/*.test.*", "{src,worker}/**/{fake,test}-*.*"],
      "rules": {
        "typescript/no-unsafe-argument": "error",
        "typescript/no-unsafe-assignment": "error",
        "typescript/no-unsafe-call": "error",
        "typescript/no-unsafe-member-access": "error",
        "typescript/no-unsafe-return": "error",
        "no-script-url": "error",
        "typescript/only-throw-error": "error"
      }
    },
    {
      "files": ["src/components/ui/map.tsx"],
      "rules": {
        "unicorn/no-useless-fallback-in-spread": "off",
        "react/set-state-in-effect": "off",
        "react/refs": "off",
        "typescript/no-floating-promises": "off",
        "typescript/no-unnecessary-type-assertion": "off",
        "react/jsx-no-constructed-context-values": "off"
      }
    },
    {
      "files": ["src/domain/**"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "globals": [
              "window",
              "document",
              "navigator",
              "HTMLElement",
              "Element",
              "Node",
              "fetch",
              "history",
              "location",
              "requestAnimationFrame",
              "cancelAnimationFrame",
              "localStorage",
              "sessionStorage"
            ],
            "checkGlobalObject": true
          }
        ]
      }
    },
    {
      "files": ["src/contract/**"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "globals": [
              "window",
              "document",
              "navigator",
              "HTMLElement",
              "Element",
              "Node",
              "history",
              "location",
              "requestAnimationFrame",
              "cancelAnimationFrame",
              "localStorage",
              "sessionStorage"
            ],
            "checkGlobalObject": true
          }
        ]
      }
    },
    {
      "files": ["src/pages/**", "src/features/**", "src/app/**"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "globals": ["history"],
            "checkGlobalObject": true
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "window",
            "property": "history",
            "message": "履歴は src/shared/browser/app-history.ts を通す。"
          },
          {
            "object": "globalThis",
            "property": "history",
            "message": "履歴は src/shared/browser/app-history.ts を通す。"
          },
          {
            "object": "self",
            "property": "history",
            "message": "履歴は src/shared/browser/app-history.ts を通す。"
          },
          {
            "property": "onpopstate",
            "message": "popstate は src/shared/browser/app-history.ts で受け取る。"
          }
        ],
        "app-history/no-popstate": "error"
      }
    },
    {
      "files": [
        "src/pages/**/*.test.*",
        "src/features/**/*.test.*",
        "src/app/**/*.test.*"
      ],
      "rules": {
        "no-restricted-globals": "off",
        "no-restricted-properties": "off",
        "app-history/no-popstate": "off"
      }
    },
    {
      "files": ["worker/**/*.ts"],
      "excludeFiles": ["**/*.test.*", "worker/**/{fake,test}-*.*"],
      "rules": { "typescript/no-unnecessary-condition": "error" }
    },
    {
      "files": ["worker/**"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "globals": [
              "window",
              "document",
              "localStorage",
              "sessionStorage",
              "navigator",
              "location"
            ],
            "checkGlobalObject": true
          }
        ]
      }
    },
    {
      "files": ["src/components/ui/map.tsx", "src/lib/utils.ts"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["**/*.test.*", "{src,worker}/**/{fake,test}-*.*"],
      "rules": {
        "typescript/no-explicit-any": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "react/refs": "off",
        "react/immutability": "off"
      }
    }
  ],
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "jsx-a11y",
    "import",
    "vitest",
    "promise"
  ],
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "import/no-mutable-exports": "error",
    "no-case-declarations": "error",
    "no-constructor-return": "error",
    "no-empty": "error",
    "no-fallthrough": "error",
    "no-loop-func": "error",
    "no-new-wrappers": "error",
    "no-proto": "error",
    "no-prototype-builtins": "error",
    "no-self-compare": "error",
    "no-unreachable-loop": "error",
    "no-useless-assignment": "error",
    "unicorn/no-abusive-eslint-disable": "error",
    "import/named": "error",
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "array-callback-return": "error",
    "react/no-danger": "error",
    "react/no-unknown-property": "error",
    "react/jsx-no-target-blank": "error",
    "jsx-a11y/anchor-ambiguous-text": [
      "error",
      {
        "words": [
          "here",
          "click here",
          "link",
          "a link",
          "learn more",
          "こちら",
          "ここ",
          "ここをクリック",
          "詳しくはこちら",
          "詳細はこちら"
        ]
      }
    ],
    "react/button-has-type": "error",
    "react/checked-requires-onchange-or-readonly": "error",
    "typescript/no-import-type-side-effects": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/return-await": ["error", "error-handling-correctness-only"],
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": [
      "error",
      { "disallowTypeAnnotations": false }
    ],
    "typescript/no-misused-promises": "error",
    "typescript/use-unknown-in-catch-callback-variable": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "vitest/no-identical-title": "error",
    "promise/no-multiple-resolved": "error",
    "promise/no-return-in-finally": "error",
    "promise/always-return": "off",
    "promise/no-callback-in-promise": "off",
    "promise/no-new-statics": "error",
    "promise/no-promise-in-callback": "error",
    "promise/valid-params": "error",
    "react/react-in-jsx-scope": "off",
    "react/set-state-in-effect": "error",
    "react/immutability": "error",
    "react/refs": "error",
    "jsx-a11y/prefer-tag-over-role": "off",
    "import/no-unassigned-import": "off",
    "unicorn/consistent-function-scoping": "off",
    "no-shadow": "off",
    "unicorn/no-array-sort": "off",
    "react/exhaustive-effect-dependencies": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/prefer-add-event-listener": "off",
    "react/memo-dependencies": "off",
    "no-unmodified-loop-condition": "off",
    "unicorn/require-module-specifiers": "off",
    "no-await-in-loop": "off",
    "oxc/no-map-spread": "off",
    "react/no-array-index-key": "off",
    "unicorn/prefer-array-find": "off",
    "react/jsx-no-constructed-context-values": "error",
    "unicorn/prefer-set-has": "off",
    "vitest/require-mock-type-parameters": "off",
    "vitest/no-conditional-expect": "off",
    "vitest/valid-expect": [
      "error",
      {
        "maxArgs": 2
      }
    ],
    "vitest/require-to-throw-message": "off",
    "vitest/expect-expect": [
      "error",
      {
        "assertFunctionNames": [
          "expect",
          "expectSeparated",
          "expectRegistrationRejected",
          "assert",
          "assertType",
          "screen.findBy*"
        ]
      }
    ],
    "vitest/no-import-node-test": "error",
    "vitest/no-mocks-import": "error",
    "vitest/no-interpolation-in-snapshots": "error",
    "vitest/no-standalone-expect": "off",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/unbound-method": "off",
    "typescript/consistent-return": "off",
    "typescript/no-unnecessary-type-parameters": "off",
    "layers/imports": "error",
    "guarded/imports": "error",
    "private-storage/names": "error",
    "context-values/no-constructed": "error"
  },
  "jsPlugins": [
    "./scripts/lint/oxlint-app-history.mjs",
    "./scripts/lint/oxlint-layers.mjs",
    "./scripts/lint/oxlint-guarded-exports.mjs",
    "./scripts/lint/oxlint-private-storage.mjs",
    "./scripts/lint/oxlint-context-values.mjs"
  ]
}
