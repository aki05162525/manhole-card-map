{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "overrides": [
    {
      "files": ["src/components/ui/map.tsx"],
      "rules": {
        "unicorn/no-useless-fallback-in-spread": "off"
      }
    },
    {
      "files": ["src/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react/**",
                  "react-dom",
                  "react-dom/**",
                  "maplibre-gl",
                  "maplibre-gl/**",
                  "../**",
                  "@/**",
                  "!../prefectures",
                  "!../prefectures.ts",
                  "!@/prefectures",
                  "!@/prefectures.ts",
                  "!@/domain",
                  "!@/domain/**",
                  "!../shared",
                  "!../shared/universal",
                  "!../shared/universal/**"
                ],
                "message": "domain は純粋な型と関数だけを持ち、上位層に依存しない（生成 prefectures と shared/universal は参照可）。"
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "globals": [
              "window",
              "document",
              "navigator",
              "HTMLElement",
              "Element",
              "Node",
              "fetch",
              "history",
              "location",
              "requestAnimationFrame",
              "cancelAnimationFrame",
              "localStorage",
              "sessionStorage"
            ],
            "checkGlobalObject": true
          }
        ]
      }
    },
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/pages",
                  "**/pages/**",
                  "**/features",
                  "**/features/**"
                ],
                "message": "shared は pages / features に依存しない。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/shared/universal/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**", "!./*", "!vitest", "!node:*"],
                "message": "universal は Worker と画面の両方が取り込む。同じディレクトリ以外に依存しない。"
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "globals": [
              "window",
              "document",
              "navigator",
              "HTMLElement",
              "Element",
              "Node",
              "history",
              "location",
              "requestAnimationFrame",
              "cancelAnimationFrame",
              "localStorage",
              "sessionStorage"
            ],
            "checkGlobalObject": true
          }
        ]
      }
    },
    {
      "files": ["src/pages/map/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/pages/cards",
                  "**/pages/cards/**",
                  "../cards",
                  "../cards/**",
                  "**/pages/about",
                  "**/pages/about/**",
                  "../about",
                  "../about/**"
                ],
                "message": "ページ同士は import しない。一覧と about は地図コードにも依存しない。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/pages/cards/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/pages/map",
                  "**/pages/map/**",
                  "../map",
                  "../map/**",
                  "**/pages/about",
                  "**/pages/about/**",
                  "../about",
                  "../about/**",
                  "**/features/map",
                  "**/features/map/**",
                  "**/components/ui/map*",
                  "maplibre-gl",
                  "maplibre-gl/**"
                ],
                "message": "ページ同士は import しない。一覧と about は地図コードにも依存しない。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/pages/about/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/pages/map",
                  "**/pages/map/**",
                  "../map",
                  "../map/**",
                  "**/pages/cards",
                  "**/pages/cards/**",
                  "../cards",
                  "../cards/**",
                  "**/features/map",
                  "**/features/map/**",
                  "**/components/ui/map*",
                  "maplibre-gl",
                  "maplibre-gl/**"
                ],
                "message": "ページ同士は import しない。一覧と about は地図コードにも依存しない。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/map/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/pages",
                  "**/pages/**",
                  "**/features/card-detail",
                  "**/features/card-detail/**",
                  "../card-detail",
                  "../card-detail/**",
                  "**/features/card-data",
                  "**/features/card-data/**",
                  "../card-data",
                  "../card-data/**"
                ],
                "message": "features は pages / 他の features に依存しない。機能同士はページが組み立てる。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/card-detail/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/pages",
                  "**/pages/**",
                  "**/features/map",
                  "**/features/map/**",
                  "../map",
                  "../map/**",
                  "**/features/card-data",
                  "**/features/card-data/**",
                  "../card-data",
                  "../card-data/**",
                  "**/components/ui/map*",
                  "maplibre-gl",
                  "maplibre-gl/**"
                ],
                "message": "features は pages / 他の features に依存しない。機能同士はページが組み立てる。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/card-data/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/pages",
                  "**/pages/**",
                  "**/features/map",
                  "**/features/map/**",
                  "../map",
                  "../map/**",
                  "**/features/card-detail",
                  "**/features/card-detail/**",
                  "../card-detail",
                  "../card-detail/**",
                  "**/components/ui/map*",
                  "maplibre-gl",
                  "maplibre-gl/**"
                ],
                "message": "features は pages / 他の features に依存しない。機能同士はページが組み立てる。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/pages/**", "src/features/**", "src/app/**"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "globals": ["history"],
            "checkGlobalObject": true
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "window",
            "property": "history",
            "message": "履歴は src/shared/browser/app-history.ts を通す。"
          },
          {
            "object": "globalThis",
            "property": "history",
            "message": "履歴は src/shared/browser/app-history.ts を通す。"
          },
          {
            "object": "self",
            "property": "history",
            "message": "履歴は src/shared/browser/app-history.ts を通す。"
          },
          {
            "property": "onpopstate",
            "message": "popstate は src/shared/browser/app-history.ts で受け取る。"
          }
        ],
        "app-history/no-popstate": "error"
      }
    },
    {
      "files": [
        "src/pages/**/*.test.*",
        "src/features/**/*.test.*",
        "src/app/**/*.test.*"
      ],
      "rules": {
        "no-restricted-globals": "off",
        "no-restricted-properties": "off",
        "app-history/no-popstate": "off"
      }
    },
    {
      "files": ["worker/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/**",
                  "**/src",
                  "**/src/**",
                  "!**/src/shared",
                  "!**/src/shared/universal",
                  "!**/src/shared/universal/**",
                  "react",
                  "react-dom",
                  "maplibre-gl"
                ],
                "message": "Worker は画面のコードに依存しない（src/shared/universal は参照可）。"
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "globals": [
              "window",
              "document",
              "localStorage",
              "sessionStorage",
              "navigator",
              "location"
            ],
            "checkGlobalObject": true
          }
        ]
      }
    }
  ],
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "import"],
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "react/react-in-jsx-scope": "off",
    "react/set-state-in-effect": "off",
    "react/immutability": "off",
    "react/refs": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "import/no-unassigned-import": "off"
  },
  "jsPlugins": ["./scripts/oxlint-app-history.mjs"]
}
