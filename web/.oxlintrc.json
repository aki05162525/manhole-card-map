{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "overrides": [
    {
      "files": ["src/components/ui/map.tsx"],
      "rules": {
        "unicorn/no-useless-fallback-in-spread": "off",
        "typescript/no-floating-promises": "off",
        "typescript/no-unnecessary-type-assertion": "off"
      }
    },
    {
      "files": ["src/domain/**"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "globals": [
              "window",
              "document",
              "navigator",
              "HTMLElement",
              "Element",
              "Node",
              "fetch",
              "history",
              "location",
              "requestAnimationFrame",
              "cancelAnimationFrame",
              "localStorage",
              "sessionStorage"
            ],
            "checkGlobalObject": true
          }
        ]
      }
    },
    {
      "files": ["src/contract/**"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "globals": [
              "window",
              "document",
              "navigator",
              "HTMLElement",
              "Element",
              "Node",
              "history",
              "location",
              "requestAnimationFrame",
              "cancelAnimationFrame",
              "localStorage",
              "sessionStorage"
            ],
            "checkGlobalObject": true
          }
        ]
      }
    },
    {
      "files": ["src/pages/**", "src/features/**", "src/app/**"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "globals": ["history"],
            "checkGlobalObject": true
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "window",
            "property": "history",
            "message": "履歴は src/shared/browser/app-history.ts を通す。"
          },
          {
            "object": "globalThis",
            "property": "history",
            "message": "履歴は src/shared/browser/app-history.ts を通す。"
          },
          {
            "object": "self",
            "property": "history",
            "message": "履歴は src/shared/browser/app-history.ts を通す。"
          },
          {
            "property": "onpopstate",
            "message": "popstate は src/shared/browser/app-history.ts で受け取る。"
          }
        ],
        "app-history/no-popstate": "error"
      }
    },
    {
      "files": [
        "src/pages/**/*.test.*",
        "src/features/**/*.test.*",
        "src/app/**/*.test.*"
      ],
      "rules": {
        "no-restricted-globals": "off",
        "no-restricted-properties": "off",
        "app-history/no-popstate": "off"
      }
    },
    {
      "files": ["worker/**"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "globals": [
              "window",
              "document",
              "localStorage",
              "sessionStorage",
              "navigator",
              "location"
            ],
            "checkGlobalObject": true
          }
        ]
      }
    },
    {
      "files": ["src/features/map/**"],
      "excludeFiles": ["src/features/map/**/*.test.*"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "error"
      }
    }
  ],
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "jsx-a11y",
    "import",
    "vitest"
  ],
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "react/react-in-jsx-scope": "off",
    "react/set-state-in-effect": "off",
    "react/immutability": "off",
    "react/refs": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "import/no-unassigned-import": "off",
    "unicorn/consistent-function-scoping": "off",
    "no-shadow": "off",
    "unicorn/no-array-sort": "off",
    "react/exhaustive-effect-dependencies": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/prefer-add-event-listener": "off",
    "react/memo-dependencies": "off",
    "no-unmodified-loop-condition": "off",
    "unicorn/require-module-specifiers": "off",
    "no-await-in-loop": "off",
    "oxc/no-map-spread": "off",
    "react/no-array-index-key": "off",
    "react/no-object-type-as-default-prop": "off",
    "unicorn/prefer-array-find": "off",
    "react/jsx-no-constructed-context-values": "off",
    "unicorn/prefer-set-has": "off",
    "vitest/require-mock-type-parameters": "off",
    "vitest/no-conditional-expect": "off",
    "vitest/valid-expect": [
      "error",
      {
        "maxArgs": 2
      }
    ],
    "vitest/require-to-throw-message": "off",
    "vitest/expect-expect": "off",
    "vitest/no-standalone-expect": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/unbound-method": "off",
    "typescript/consistent-return": "off",
    "typescript/no-unnecessary-type-parameters": "off",
    "layers/imports": "error"
  },
  "jsPlugins": [
    "./scripts/oxlint-app-history.mjs",
    "./scripts/oxlint-layers.mjs"
  ]
}
