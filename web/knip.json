{
  "$schema": "./node_modules/knip/schema.json",
  "entry": [
    "index.html",
    "cards.html",
    "about.html",
    "404.html",
    "account.html",
    "terms.html",
    "friends.html",
    "friends/invite.html",
    "src/shared/ui/document-transitions.css",
    "scripts/**/*.mjs",
    "src/pages/card/static-pages.tsx",
    "src/pages/cards/static-catalog.tsx",
    "src/**/*.test.{ts,tsx}",
    "scripts/**/*.test.ts",
    "worker/**/*.test.ts",
    "mutator.config.ts",
    "vitest.mutator.config.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.{ts,tsx,mjs}",
    "worker/**/*.ts",
    "*.ts",
    "src/**/*.css"
  ],
  "ignoreIssues": {
    "src/components/ui/map.tsx": ["exports", "types"],
    "src/lib/utils.ts": ["exports", "types"]
  },
  "ignoreDependencies": [
    "@fontsource-variable/noto-sans-jp",
    "lefthook",
    "tsrs"
  ]
}
