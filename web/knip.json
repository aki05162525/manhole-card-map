{
  "$schema": "./node_modules/knip/schema.json",
  "entry": [
    "index.html",
    "cards.html",
    "about.html",
    "404.html",
    "src/shared/ui/document-transitions.css",
    "scripts/*.mjs",
    "scripts/static-pages.tsx",
    "src/**/*.test.{ts,tsx}",
    "scripts/**/*.test.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.{ts,tsx,mjs}",
    "*.ts",
    "src/**/*.css"
  ],
  "ignoreIssues": {
    "src/components/ui/map.tsx": ["exports", "types"],
    "src/lib/utils.ts": ["exports", "types"]
  },
  "ignoreDependencies": ["wrangler", "lefthook"]
}
