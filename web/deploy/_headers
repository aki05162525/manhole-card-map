/*
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://basemaps.cartocdn.com https://tiles.basemaps.cartocdn.com; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
/account
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
/account.html
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
/assets/*
  Cache-Control: public, max-age=31536000, immutable
