           <div id="bk13104" class="b-plain c-space_normal c-sp-space_normal c-padding_normal c-sp-padding_normal cssskin-sp_1" data-bk-id="bk13104"> 
            <div class=" column -column1"> 
             <h4 class=" c-small_headline"><span class=" d-large_font">境南ハロウィンフェス2026</span><br><span class=" d-large_font"><span style="caret-color:#333333; -webkit-text-stroke-width:0px; font-variant-caps:normal; color:#333333; white-space:normal; letter-spacing:normal; text-rendering:optimizelegibility; font-style:normal; box-sizing:border-box; -webkit-font-smoothing:antialiased; text-transform:none; word-spacing:0px; text-indent:0px;" class=" d-bold d-gothic c-start">2026年10月25日(日) 12:00 ～20:00</span></span></h4> 
             <p class=" c-body"><span style="color:#ff00ff;" class=" d-large_font"><span style="caret-color:#333333; -webkit-text-stroke-width:0px; font-variant-caps:normal; white-space:normal; letter-spacing:normal; text-rendering:optimizelegibility; font-style:normal; box-sizing:border-box; -webkit-font-smoothing:antialiased; text-transform:none; word-spacing:0px; text-indent:0px;" data-sitecolor-text="" class=" d-bold d-gothic c-start">イベントは終了いたしました。</span></span></p> 
            </div> 
           </div> 
           <div id="bk13105" class="b-plain c-space_normal c-sp-space_normal c-padding_normal c-sp-padding_normal cssskin-_block_main" data-bk-id="bk13105"> 
            <div class=" g-column -col2 -sp-col1"> 
             <div class=" column -column1"> 
              <div class=" c-body"> 
               <div class="c-img   "> 
                <picture> 
                 <source type="image/webp" srcset="_src/6871/chirashi.webp?v=1793253214576"> 
                 <img src="_src/6871/chirashi.png?v=1793253214576" width="800" height="1119" alt="" id="imgsrc6871_1" loading="lazy"> 
                </picture> 
               </div> 
              </div> 
             </div> 
             <div class=" column -column2 -column-lasts"> 
              <div class=" c-body"> 
               <div class="c-img   "> 
                <picture> 
                 <source type="image/webp" srcset="_src/6873/chirashi2.webp?v=1793253214576"> 
                 <img src="_src/6873/chirashi2.jpg?v=1793253214576" width="800" height="1139" alt="" id="imgsrc6873_1" loading="lazy"> 
