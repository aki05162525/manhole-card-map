	<!-- script -->
	<script src="/assets/js/jquery-3.7.0.min.js"></script>
	<script src="/assets/js/common.js"></script>
	<script src="/assets/js/slick.js"></script>
	<script>
		$(function() {
			$('.slider').slick({
				pauseOnHover: false,
				infinite: false,
				fade: true,
				dots: true,
				arrows: true
			});
				
			$(".acBtn").on("click", function() {
				var $infoArea = $(".infoArea");
				var $acContents = $(this).prev(".acContents");
				var $infoImg = $acContents.find(".infoImg img"); // 特定の画像

				// アコーディオンを開閉
				$infoArea.toggleClass("acToggle");
				$acContents.slideToggle(function() {
					// スライドアニメーションが完了した後に画像のフェードインを制御
					if ($acContents.is(":visible")) {
						$infoImg.addClass("visible");
					} else {
						$infoImg.removeClass("visible");
					}
				});
			});
		});
	</script>
