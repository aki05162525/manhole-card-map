		<!-- content -->
		<div class="content">

			<!-- main -->
			<main>
				<section id="prologue">
					<div class="innerSp100">
						<iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6475.9278332241365!2d139.5859966944721!3d35.751691640258116!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6018efc3552c8307%3A0xee5f969e1ad151ac!2z5p2x5pig44Ki44OL44Oh44O844K344On44Oz44Of44Ol44O844K444Ki44Og!5e0!3m2!1sja!2sjp!4v1692323263657!5m2!1sja!2sjp" width="100%" height="500" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
				</div>
				</section>
				<section id="howToAccess">
					<div class="inner">
						<div class="accessInfoWrap">
							<h2 class="headingRedBdr"><span>住所</span></h2>
							<p>〒178-8567　<br class="pcNone">東京都練馬区東大泉2-10-5</p>
						</div>
						<div class="accessInfoWrap">
							<h2 class="headingRedBdr"><span>ミュージアムの入口はこちら</span></h2>
							<figure><img src="/assets/img/access/img_access.jpg" alt="東映アニメーションミュージアム入口"></figure>
						</div>
						<div class="accessInfoWrap">
							<h2 class="headingRedBdr"><span>アクセス方法</span></h2>
							<div class="boxWrap Two">
								<div class="whiteBox">
									<dl class="headingRedBdr">
										<dt>西武池袋線「大泉学園」駅北口より</dt>
										<dd>
											<ul class="accessInfoList">
												<li class="iconWalk">徒歩約15分でお越しいただけます。</li>
												<li class="iconBus">北口を出てすぐ右手にあるバス停、1番乗り場から、以下のいずれかのバスにご乗車ください。<br>
													「東映撮影所前」で下車（約5分）<br>
													<span>
														●「和光市駅南口」行き<br>
														●「長久保」行き
													</span>
												</li>
												<li class="iconTaxi">北口から右手にタクシー乗り場がございます。</li>
											</ul>
										</dd>
									</dl>
								</div>
								<div class="whiteBox">
									<dl class="headingRedBdr">
										<dt>西武池袋線「石神井公園」駅北口より</dt>
										<dd>
											<ul class="accessInfoList">
												<li class="iconBus">1番乗り場から、以下のいずれかのバスにご乗車ください。<br>
													「東映撮影所前」で下車（約10分）<br>
													<span>
														●「成増駅南口」行き<br>
														●「成増駅経由練馬北町車庫」行き<br>
														●「石神井循環」
													</span>
												</li>
												<li class="iconTaxi">北口・南口各ロータリーにタクシー乗り場がございます。</li>
											</ul>
										</dd>
									</dl>
								</div>
							</div>
							<div class="iconCaution">
								<p>恐れ入りますが、当施設には駐車場のご用意がございません。公共交通機関のご利用にご協力をお願いいたします。</p>
							</div>
						</div>
					</div>
				</section>
