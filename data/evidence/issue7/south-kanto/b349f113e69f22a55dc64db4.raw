        var scroll;
        $(window).scroll(function () {
            scroll = $(window).scrollTop();
            //if ($(window).scrollTop() > height) {
              if ((scroll > $('header').height()) && (scroll <= $('footer').offset().top - $(window).height())) {
              $('.layer1').css({'position': 'fixed'});
