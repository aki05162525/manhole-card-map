<script id="google-invisible-recaptcha-js-before">
var renderInvisibleReCaptcha = function() {

    if (typeof grecaptcha === 'undefined' || typeof grecaptcha.render !== 'function') return;

    for (var i = 0; i < document.forms.length; ++i) {
        var form = document.forms[i];
        var holder = form.querySelector(".inv-recaptcha-holder");

        if (null === holder || holder.closest('form') !== form || holder.getAttribute('data-invre-rendered')) continue;
        holder.innerHTML = '';

        try {
            (function(frm, holderElm){
                var cf7SubmitElm = frm.querySelector('.wpcf7-submit, .invisible-recaptcha-do-submit');
                var holderId = grecaptcha.render(holderElm,{
                    'sitekey': "6LdXGXAaAAAAAAVI7QeJY6FrQjZ-V1ei5Y9xAkT9", 'size': 'invisible', 'badge' : "inline",
                    'callback' : function (recaptchaToken) {
                        if((null !== cf7SubmitElm) && (typeof jQuery != 'undefined')){jQuery(frm).submit();grecaptcha.reset(holderId);return;}
                        HTMLFormElement.prototype.submit.call(frm);
                    },
                    'expired-callback' : function(){grecaptcha.reset(holderId);}
                });
                holderElm.setAttribute('data-invre-rendered', '1');

                if(null !== cf7SubmitElm && (typeof jQuery != 'undefined') ){
                    jQuery(cf7SubmitElm).off('click').on('click', function(clickEvt){
                        clickEvt.preventDefault();
                        grecaptcha.execute(holderId);
                    });
                }
                else
                {
                    frm.onsubmit = function (evt){evt.preventDefault();grecaptcha.execute(holderId);};
                }
            })(form, holder);
        } catch (err) {
            if (window.console && console.error) console.error('Invisible reCAPTCHA:', err);
        }
    }
};

(function(){
    var scheduled = false;
    var scheduleRender = function() {
        if (scheduled) return;
        scheduled = true;
        setTimeout(function(){ scheduled = false; renderInvisibleReCaptcha(); }, 50);
    };

    // Forms re-rendered by Gravity Forms (AJAX validation errors, multi-page, confirmation).
    var bindJqueryEvents = function() {
        if (typeof jQuery == 'undefined' || bindJqueryEvents.done) return;
        bindJqueryEvents.done = true;
        jQuery(document).on('gform_post_render gform_page_loaded', scheduleRender);
    };
    bindJqueryEvents();
    document.addEventListener('DOMContentLoaded', bindJqueryEvents);
    window.addEventListener('load', bindJqueryEvents);

    // Any other form inserted after page load (popups, builders, AJAX-loaded content).
    if (window.MutationObserver) {
        new MutationObserver(function(mutations){
            for (var m = 0; m < mutations.length; ++m) {
                for (var n = 0; n < mutations[m].addedNodes.length; ++n) {
                    var node = mutations[m].addedNodes[n];
                    if (1 === node.nodeType && ('FORM' === node.tagName || (node.querySelector && node.querySelector(".inv-recaptcha-holder")))) {
                        scheduleRender();
                        return;
                    }
                }
            }
        }).observe(document.documentElement, {childList: true, subtree: true});
    }
})();
