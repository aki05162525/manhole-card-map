  "script": "import json,hashlib,sys\nfrom pathlib import Path\nsys.path.insert(0,'tools/national')\nfrom research_common import decode_tile,rounded_coordinate\nfrom location_lifecycle import digest\nE=Path('data/evidence/kanto-prefecture/ibaraki/round2/tsuchiura');N=Path('data/national/kanto-prefecture/ibaraki/round2/tsuchiura')\ndef read(p):return json.loads(Path(p).read_text())\ndef sha(p):return hashlib.sha256(Path(p).read_bytes()).hexdigest()\nr=read(E/'retrievals.json')\nfor x in r:\n if x['status']=='acquired':assert sha(x['rawPath'])==x['sha256']\nprint('PASS primary retrieval hashes:',sum(x['status']=='acquired' for x in r),'failed attempts retained:',sum(x['status']!='acquired' for x in r))\nfor w in ['kura','station','tennis','yukiiri']:\n for t in read(E/w/'vector-window.json')['tiles']:assert sha(t['retainedPath'])==t['sha256']\n rs=read(E/w/'vector-retrievals.json');assert all(x['status'] in ['acquired','cached'] and x['httpStatus']==206 and sha(x['rawPath'])==x['sha256'] for x in rs);assert len({(x['etag'],x['lastModified']) for x in rs})==1\nprint('PASS 36 retained tile hashes and four coherent HTTP Range windows')\nfor n in ['ichu','station','tennis','kura','yukiiri']:\n g=read(E/(n+'-geometry.json'));raw=Path(g['snapshotPath']).read_bytes();f=decode_tile(raw)['BldA']['features'][g['featureIndex']];assert f['geometry']==g['geometry'];assert g['calculation']==rounded_coordinate(f['geometry'],g['tile'],g['selectedTileXY']);assert g['calculation']['roundedWithin'];assert not g['tileBoundaryTouched']\nprint('PASS five raw feature bindings, 7-digit rounded containment, no selected polygon touches tile boundary')\nold=read(E/'reused-render-mapping.json')['mapping'];assert next(x['feature']['geometry'] for x in old if x['renderId']==4384)==read(E/'ichu-geometry.json')['geometry']\nprint('PASS old render4384 equals newly fetched BldA86 geometry')\nh=read(E/'history-inherited.json');assert sha(h['source'])==h['sha256']\nfor f in h['facilities']:\n for x in f['resolvedHistory']:\n  p,_,ptr=x['ref'].partition('#');assert sha(p)==x['sha256']\n  if ptr:\n   v=read(p)\n   for k in ptr.strip('/').split('/'):v=v[int(k)] if isinstance(v,list) else v[k]\n for x in f['verifiedOriginals']:assert sha(x['snapshotPath'])==x['snapshotSHA256']\nprint('PASS all five inherited histories, JSON pointers and verified original hashes')\nus=read(N/'locations-proposed.json')['updates'];bs=read(N/'location-lifecycle-proposed.json')['bindings'];sel=read(N/'manifest-selection-proposed.json');old=read(E/'old-values.json');assert len(us)==len(bs)==5\nfor u,b in zip(us,bs):\n assert u==b['adoption'] and digest(u)==b['adoptionSHA256'];p=next(p for p in old['places'] if p['id']==u['facilityId']);assert not p.get('coordinate');assert b['identity']=={k:p[k] for k in ['name','address']};assert sha(u['evidence']['snapshotPath'])==u['evidence']['snapshotSHA256']\nassert sel['locations'][0]['approved']==[dict(facilityId=u['facilityId'],sha256=digest(u)) for u in us];assert sha(N/'location-lifecycle-proposed.json')==sel['locationLifecycle'][0]['sha256'];assert sha('tools/national/manifest.json')==old['manifestSHA256']\nprint('PASS proposed ID/old-value/hash/lifecycle/explicit-selection bindings; shared manifest unchanged')\nprint('NOT RUN full suite, commit hooks, independent review, parent merge/assembly diff. Mechanical checks do not approve identity or CRS.')\n",
