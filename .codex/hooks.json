{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$(git rev-parse --show-toplevel)/tools/agents/command_guard.py\"",
            "timeout": 30,
            "statusMessage": "Checking Git safety rules"
          }
        ]
      },
      {
        "matcher": "^mcp__t3[-_]code[A-Za-z0-9_-]*__delegate_task$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$(git rev-parse --show-toplevel)/tools/agents/delegate_guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking delegation rules"
          }
        ]
      }
    ]
  }
}
