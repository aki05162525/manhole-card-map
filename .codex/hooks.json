{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && [ -f \"$root/tools/agents/command_guard.py\" ] || exit 0; exec python3 -B \"$root/tools/agents/command_guard.py\"",
            "timeout": 30,
            "statusMessage": "Checking Git safety rules"
          }
        ]
      },
      {
        "matcher": "^mcp__t3[-_]code[A-Za-z0-9_-]*__delegate_task$",
        "hooks": [
          {
            "type": "command",
            "command": "root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && [ -f \"$root/tools/agents/delegate_guard.py\" ] || exit 0; exec python3 -B \"$root/tools/agents/delegate_guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking delegation rules"
          }
        ]
      }
    ]
  }
}
