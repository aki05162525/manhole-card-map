{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$(git rev-parse --show-toplevel)/tools/agents/command_guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking Git safety rules"
          }
        ]
      }
    ]
  }
}
